# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive
[Mm]emoryCaptures/

# Recordings can get excessive
[Rr]ecordings/

# Uncomment this if you don't want to track asset meta files
# *.meta

# Visual Studio cache directory
.vs/

# Rider cache directory
.idea/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
[Aa]ddressables*Binaries/

# Temporary auto-generated Android Assets
[Ss]treamingAssets/aa.meta
[Ss]treamingAssets/aa/*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ML-Agents specific
results/
*.onnx
summaries/

# Python virtual environment (if you have one in the project)
venv/
.env/
__pycache__/
*.py[cod]

# ML-Agents training checkpoints (optional - you might want to keep these)
# Uncomment the next line if you want to ignore training results
# results/
